# Copy this file to terraform.tfvars and fill in your real values.
# terraform.tfvars is gitignored — never commit it (it can contain your public IP).

aws_region        = "us-east-1"
project_name      = "zero-trust-platform"
availability_zone = "us-east-1a"

# Get yours from: curl https://checkip.amazonaws.com
my_ip_cidr = "REPLACE_ME/32"

# Either set this to an EXISTING key pair name you already created in AWS...
key_pair_name = "REPLACE_ME"

# ...OR leave key_pair_name blank and point this at a local public key instead:
# ssh_public_key_path = "~/.ssh/id_rsa.pub"

instance_type = "t3.medium"
